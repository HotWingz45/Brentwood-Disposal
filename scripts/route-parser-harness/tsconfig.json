{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "rootDir": "../..",
    "outDir": "./dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../../src/services/routeImport/parseRouteText.ts",
    "../../src/services/routeImport/parseTabularStops.ts",
    "../../src/services/routeImport/parseBrentwoodTable.ts",
    "../../src/services/routeImport/normalizeStops.ts",
    "../../src/services/routeImport/validateStops.ts",
    "../../src/services/routeImport/types.ts",
    "../../src/models/Stop.ts"
  ],
  "exclude": ["./dist"]
}
