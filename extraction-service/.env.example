# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Limits ───────────────────────────────────────────────────────
# Max base64 payload size in bytes (default 25 MB = covers ~18 MB actual files)
MAX_PAYLOAD_BYTES=26214400
# Extraction timeout in milliseconds
EXTRACTION_TIMEOUT_MS=60000
# OCR timeout per page in milliseconds
OCR_TIMEOUT_MS=30000

# ── OCR ───────────────────────────────────────────────────────────
# Set to "true" to enable OCR for scanned PDFs.
# Requires: canvas npm package + system libs (libcairo2, libpango, etc.)
ENABLE_OCR=false

# Minimum chars-per-page to consider a PDF "selectable" (avoid unnecessary OCR)
OCR_THRESHOLD_CHARS_PER_PAGE=80

# ── AI cleanup (optional) ────────────────────────────────────────
# Provider: "openai" | "" (empty = disabled)
AI_CLEANUP_PROVIDER=

# OpenAI settings (when AI_CLEANUP_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Security ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Empty = allow all (dev only).
ALLOWED_ORIGINS=
