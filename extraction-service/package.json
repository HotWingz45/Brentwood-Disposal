{
  "name": "brentwood-extraction-service",
  "version": "1.0.0",
  "description": "Document extraction backend for Brentwood Disposal route imports",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prestart": "node -e \"require('fs').accessSync('dist/index.js')\"",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec \"ts-node src/index.ts\" --ext ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2"
  }
}
